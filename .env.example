# ---- Discord ----
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
# Channel where the persistent "shop" embed (screenshot) lives
DISCORD_SHOP_CHANNEL_ID=
# Optional: channel where failed payouts / unmatched in-game payments get
# alerted so an operator can step in. Leave blank to just log them instead.
DISCORD_ADMIN_ALERT_CHANNEL_ID=

# ---- DonutSMP ----
# Get this in-game by running /api on DonutSMP
DONUTSMP_API_KEY=
# In-game username of the bank/bot account (must match the Mineflayer login)
DONUTSMP_BANK_IGN=

# ---- Mineflayer (bank account) ----
# Premium Microsoft account used to log the bank bot into DonutSMP.
# Uses Microsoft device-code auth by default — leave MC_AUTH=microsoft and
# the bot will print a one-time login URL/code to the console on first run,
# then cache the token so it won't ask again.
MC_HOST=donutsmp.net
MC_PORT=25565
MC_AUTH=microsoft
MC_USERNAME=
MC_PROFILES_FOLDER=./data/mc-auth-cache

# ---- Pricing ----
# USD per in-game million ($) of money sold, and max sell per order (in millions)
RATE_USD_PER_MILLION=0.0185
MAX_SELL_MILLIONS=14180
# Per-user daily sell cap (millions), fraud guard
DAILY_SELL_CAP_MILLIONS=2000
# Minutes a pending order stays open before auto-expiring
ORDER_TIMEOUT_MINUTES=10

# ---- LTC hot wallet ----
# BIP39 mnemonic for a DEDICATED hot wallet (do NOT reuse your main Exodus
# seed here). Fund it manually from cold storage / Exodus as needed.
LTC_HOT_WALLET_MNEMONIC=
# Optional BIP39 passphrase, leave blank if none
LTC_HOT_WALLET_PASSPHRASE=
# Broadcast/UTXO provider (see src/wallet/broadcast.js for supported ones)
LTC_ESPLORA_API=https://litecoinspace.org/api

# ---- Database ----
DATABASE_PATH=./data/autosell.sqlite

# ---- Ops ----
LOG_LEVEL=info
